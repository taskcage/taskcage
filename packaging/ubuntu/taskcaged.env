# taskcaged의 모든 serve 상한은 명시적으로 설정한다.
TASKCAGE_SOCKET=/run/taskcage/taskcaged.sock
TASKCAGE_MAX_CONCURRENT_TASKS=4
TASKCAGE_MAX_REGISTRY_TASKS=1000
TASKCAGE_MAX_CONCURRENT_CONNECTIONS=32
TASKCAGE_CLEANUP_TIMEOUT_MS=5000
TASKCAGE_FAIL_STOP_TIMEOUT_MS=10000
TASKCAGE_MAX_TASK_CPU_QUOTA_US=200000
TASKCAGE_MAX_TASK_CPU_PERIOD_US=100000
TASKCAGE_MAX_TASK_MEMORY_BYTES=2147483648
TASKCAGE_MAX_TASK_PIDS=128
TASKCAGE_MAX_TASK_TIMEOUT_MS=900000
TASKCAGE_MAX_TASK_STDOUT_TAIL_BYTES=65536
TASKCAGE_MAX_TASK_STDERR_TAIL_BYTES=65536
TASKCAGE_LOG_FORMAT=json
RUST_LOG=taskcaged=info
# 비어 있으면 metrics endpoint를 열지 않는다. 예: --metrics-listen 127.0.0.1:9098
TASKCAGE_METRICS_ARGS=
