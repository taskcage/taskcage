[Unit]
Description=TaskCage external process runtime
Documentation=https://github.com/taskcage/taskcage/blob/main/docs/install-ubuntu.md
After=local-fs.target
ConditionFileIsExecutable=/usr/local/bin/taskcaged

[Service]
Type=simple
User=taskcage
Group=taskcage
RuntimeDirectory=taskcage
RuntimeDirectoryMode=0700
Environment=RUST_LOG=taskcaged=info
EnvironmentFile=/etc/taskcage/taskcaged.env
ExecStart=/usr/local/bin/taskcaged serve \
  --socket ${TASKCAGE_SOCKET} \
  --max-concurrent-tasks ${TASKCAGE_MAX_CONCURRENT_TASKS} \
  --max-registry-tasks ${TASKCAGE_MAX_REGISTRY_TASKS} \
  --max-concurrent-connections ${TASKCAGE_MAX_CONCURRENT_CONNECTIONS} \
  --cleanup-timeout-ms ${TASKCAGE_CLEANUP_TIMEOUT_MS} \
  --fail-stop-timeout-ms ${TASKCAGE_FAIL_STOP_TIMEOUT_MS} \
  --max-task-cpu-quota-us ${TASKCAGE_MAX_TASK_CPU_QUOTA_US} \
  --max-task-cpu-period-us ${TASKCAGE_MAX_TASK_CPU_PERIOD_US} \
  --max-task-memory-bytes ${TASKCAGE_MAX_TASK_MEMORY_BYTES} \
  --max-task-pids ${TASKCAGE_MAX_TASK_PIDS} \
  --max-task-timeout-ms ${TASKCAGE_MAX_TASK_TIMEOUT_MS} \
  --max-task-stdout-tail-bytes ${TASKCAGE_MAX_TASK_STDOUT_TAIL_BYTES} \
  --max-task-stderr-tail-bytes ${TASKCAGE_MAX_TASK_STDERR_TAIL_BYTES}
Delegate=yes
KillMode=control-group
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=multi-user.target
